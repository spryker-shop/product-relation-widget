{% extends template('widget') %}

{# itemListId, itemListName - identify the list for the traceable events, e.g. GA4 view_item_list; the list has no visible title. #}
{% define data = {
    products: [],
    isNewCarouselRenderingEnabled: false,
    itemListId: null,
    itemListName: null,
} %}

{% block body %}
    {% if data.products is not empty %}
        <div{% if data.itemListId %} data-item-list-id="{{ data.itemListId }}" data-item-list-name="{{ data.itemListName }}"{% endif %}>
        {% set sliderConfig = data.isNewCarouselRenderingEnabled
        ? {
            modifiers: ['inset'],
            data: {
                slides: data.products,
                showDots: false,
            },
            attributes: {
                'slides-to-show': 4,
                'is-new-carousel-rendering-enabled': true,
            },
        } : {
            modifiers: ['inset'],
            class: 'is-hidden-sm-md',
            data: {
                slides: data.products,
                showDots: false,
            },
            attributes: {
                'slides-to-show': 4,
            },
        } %}

        {% embed molecule('simple-carousel') with sliderConfig only %}
            {% block slide %}
                {% widget 'PdpProductRelationWidget' args [slide] only %}
                {% elsewidget 'ProductWidgetPlugin' args [slide] only %} {# @deprecated Use PdpProductRelationWidget instead. #}
                {% endwidget %}
            {% endblock %}
        {% endembed %}

        {% if not data.isNewCarouselRenderingEnabled %}
            {% embed molecule('simple-carousel') with {
                class: 'is-hidden-lg-xl',
                data: {
                    slides: data.products,
                    showDots: false
                },
                attributes: {
                    'slides-to-show': 1
                }
            } only %}
                {% block slide %}
                    {% widget 'PdpProductRelationWidget' args [slide] only %}
                    {% elsewidget 'ProductWidgetPlugin' args [slide] only %} {# @deprecated Use PdpProductRelationWidget instead. #}
                    {% endwidget %}
                {% endblock %}
            {% endembed %}
        {% endif %}

        {% block productTrackingDetails %}
            {% widget 'ProductTrackingDetailsWidget' args [data.products] only %}{% endwidget %}
        {% endblock %}
        </div>
    {% endif %}
{% endblock %}
